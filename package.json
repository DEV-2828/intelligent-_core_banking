{
  "name": "intelligent-core-banking",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "seed:passwords": "node --env-file=.env.local scripts/seed-demo-passwords.mjs",
    "mongo:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-mongodb.ps1",
    "db:check": "node --env-file=.env.local scripts/check-databases.mjs",
    "db:setup:mongo": "node --env-file=.env.local scripts/setup-mongo.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate-mysql.mjs",
    "sync:loans": "node --env-file=.env.local --import ./scripts/register-ts.mjs --experimental-strip-types scripts/sync-loans.mjs",
    "test": "node --import ./scripts/register-ts.mjs --experimental-strip-types --test tests/unit.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "mongodb": "^7.0.0",
    "mysql2": "^3.15.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  }
}
